# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
# Optional: use a Messaging Service (A2P 10DLC campaign) instead of a single From number
TWILIO_MESSAGING_SERVICE_SID=
# Ops phone that gets driver problem alerts (E.164, e.g. +18182170070); unset = no ops texts
EPYC_OPS_SMS=

# Web push (driver app job alerts; Phase 3b). Public key hides the alerts button when empty.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.epyccs.com

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@epyccs.com

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/1234567
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=epyc-web
SENTRY_AUTH_TOKEN=your-sentry-auth-token
